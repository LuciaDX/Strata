{
  "name": "@strata/workbench",
  "productName": "Strata",
  "version": "0.1.0",
  "description": "Node-based workbench for protecting Minecraft Bedrock resource packs",
  "author": "Neopolitan",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "electron .",
    "package": "vite build && electron-builder",
    "package:win": "vite build && electron-builder --win",
    "package:mac": "vite build && electron-builder --mac",
    "package:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@strata/core": "0.1.0",
    "@strata/nodes": "0.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.8.0",
    "electron": "38.8.6",
    "electron-builder": "^26.15.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "app.strata.workbench",
    "productName": "Strata",
    "copyright": "Copyright 2026 Neopolitan",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      }
    ],
    "artifactName": "Strata-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "executableName": "strata",
      "category": "Development"
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
